{
    "packages": {
        "php": "8.3",
        "node": "22"
    },
    "build": {
        "steps": [
            {
                "name": "install:composer",
                "cmds": ["composer install --optimize-autoloader --no-scripts --no-interaction"]
            },
            {
                "name": "install:node",
                "cmds": ["npm ci"]
            },
            {
                "name": "prune:node",
                "cmds": ["npm prune --omit=dev --ignore-scripts"]
            },
            {
                "name": "build",
                "cmds": [
                    "mkdir -p storage/framework/{sessions,views,cache,testing} storage/logs bootstrap/cache && chmod -R a+rw storage",
                    "php artisan config:cache",
                    "php artisan event:cache",
                    "php artisan route:cache",
                    "php artisan view:cache"
                ]
            }
        ]
    },
    "deploy": {
        "startCommand": "/start-container.sh"
    }
}
